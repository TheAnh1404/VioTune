# VioTune Backend Environment Configuration

DATABASE_URL=sqlite:///data/viotune.db
FIREBASE_PROJECT_ID=viotuneteam6

# Optional: Path to Google Cloud Firestore Service Account Key file
# If set, the backend will use the official google-cloud-firestore Python SDK
# If not set, it will fallback to the paginated resilient REST client
# FIREBASE_CREDENTIALS_PATH=path/to/serviceAccountKey.json

DEEZER_TIMEOUT=6
PORT=8000
HOST=127.0.0.1
